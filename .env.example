# ==========================================
# GraphRAGPortfolio Monorepo Environment Config
# ==========================================

# ------------------------------------------
# Frontend Environment Variables (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# Backend Environment Variables (FastAPI)
# ------------------------------------------
# LLM / Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Vector Store Config
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=portfolio-rag

# Optional: HuggingFace / Embedding Models
HUGGINGFACE_API_KEY=your_huggingface_key_here

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,https://bargady.online
